{=include-block:Y_Blocks.txt;management_check_top=}
{=include-block:Y_Blocks.txt;head=}
<script type="text/javascript" src="/Y_Baselib.js"></script>
<script type="text/javascript">
//<![CDATA[
var shares = [];

function netmount(params)
{
	var query = "";
	for (var key in params)
		query += (query ? "&" : "?") + key + "=" + encodeURIComponent(params[key]);
	return loadSyncURL("/control/netmount" + query).replace(/\s+$/, "");
}

function cell(row, text)
{
	var td = row.insertCell(-1);
	td.appendChild(document.createTextNode(text));
	return td;
}

function button(td, text, action)
{
	var b = document.createElement("input");
	b.type = "button";
	b.value = text;
	b.onclick = action;
	td.appendChild(b);
}

function show(text)
{
	document.getElementById("result").textContent = text == "ok" ? "" : text;
}

function refresh()
{
	var table = document.getElementById("shares");
	while (table.rows.length > 1)
		table.deleteRow(1);
	shares = [];
	var lines = netmount({}).split("\n");
	for (var i = 0; i < lines.length; i++) {
		var f = lines[i].split("\t");
		if (f.length < 11)
			continue;
		var s = { nr: f[0], type: f[1], ip: f[2], dir: f[3], local_dir: f[4], automount: f[5] == "1",
			  mounted: f[6] == "1", username: f[7], options1: f[8], options2: f[9], mac: f[10] };
		shares.push(s);
		if (!s.ip)
			continue;
		var row = table.insertRow(-1);
		cell(row, s.type.toUpperCase());
		cell(row, s.type == "cifs" ? "//" + s.ip + "/" + s.dir : s.ip + ":" + s.dir);
		cell(row, s.local_dir);
		cell(row, (s.mounted ? "mounted" : "") + (s.automount ? (s.mounted ? ", " : "") + "at start" : ""));
		var td = row.insertCell(-1);
		(function(s) {
			button(td, s.mounted ? "Unmount" : "Mount", function() {
				show_waitbox(true);
				show(netmount({ action: s.mounted ? "umount" : "mount", nr: s.nr }));
				show_waitbox(false);
				refresh();
			});
			button(td, "Edit", function() { edit(s); });
		})(s);
	}
	if (table.rows.length == 1)
		cell(table.insertRow(-1), "No network share set up yet").colSpan = 5;
	var free = null;
	for (var i = 0; i < shares.length && !free; i++)
		if (!shares[i].ip)
			free = shares[i];
	var add = document.getElementById("add");
	add.disabled = !free;
	add.onclick = function() {
		free.type = "cifs";
		free.options1 = free.options2 = free.mac = "";
		edit(free);
	};
}

function type_changed()
{
	var cifs = document.f.type.value == "cifs";
	document.getElementById("login1").style.display = cifs ? "" : "none";
	document.getElementById("login2").style.display = cifs ? "" : "none";
	document.getElementById("dir_label").textContent = cifs ? "Share" : "Exported directory";
}

function edit(s)
{
	var f = document.f;
	f.nr.value = s.nr;
	f.type.value = s.type == "cifs" ? "cifs" : "nfs";
	f.ip.value = s.ip;
	f.dir.value = s.dir;
	f.local_dir.value = s.ip ? s.local_dir : "/media/net" + (parseInt(s.nr) + 1);
	f.username.value = s.username;
	f.password.value = "";
	f.automount.checked = s.automount;
	f.options1.value = s.options1;
	f.options2.value = s.options2;
	f.mac.value = s.mac;
	document.getElementById("edit_head").textContent = s.ip ? "Share " + s.ip + "/" + s.dir : "New share";
	document.getElementById("edit").style.display = "";
	type_changed();
}

function save(then_mount)
{
	var f = document.f;
	var cifs = f.type.value == "cifs";
	var dir = f.dir.value.replace(/^\s+|\s+$/g, "");
	if (cifs)
		dir = dir.replace(/^\/+/, "");
	var r = netmount({ action: "set", nr: f.nr.value, type: f.type.value, ip: f.ip.value.replace(/^\s+|\s+$/g, ""),
			   dir: dir, local_dir: f.local_dir.value.replace(/^\s+|\s+$/g, ""),
			   automount: f.automount.checked ? 1 : 0, username: cifs ? f.username.value : "",
			   password: cifs ? f.password.value : "", options1: f.options1.value,
			   options2: f.options2.value, mac: f.mac.value });
	show(r);
	if (r == "ok") {
		document.getElementById("edit").style.display = "none";
		if (then_mount) {
			show_waitbox(true);
			show(netmount({ action: "mount", nr: f.nr.value }));
			show_waitbox(false);
		}
	}
	refresh();
}

function clear_entry()
{
	var f = document.f;
	if (!confirm("Remove this share?"))
		return;
	f.ip.value = f.dir.value = f.local_dir.value = f.username.value = f.password.value = f.mac.value = "";
	f.automount.checked = false;
	save(false);
}
//]]>
</script>
</head>
<body>
{=var-set:wait_text={=L:save_values=}=}{=include-block:Y_Blocks.txt;snip_wait=}
<div class="work_box">
	<div class="work_box_head">
		<div class="work_box_head_h2">{=var-set:help_url=Help-Tools-Mounts=}{=var-set:menu=Network shares=}{=include-block:Y_Blocks.txt;work_menu=}</div>
	</div>
	<div class="work_box_body">
	<table border="0" class="y_form_table" id="shares">
		<tr><td class="y_form_header">Type</td><td class="y_form_header">Share</td><td class="y_form_header">Local directory</td><td class="y_form_header">State</td><td class="y_form_header"></td></tr>
	</table>
	<p><input type="button" id="add" value="Add share"/></p>
	<form name="f" action="javascript:void(0)">
		<div id="edit" style="display:none">
		<input type="hidden" name="nr" value="0"/>
		<table border="0" class="y_form_table">
			<tr><td colspan="2" class="y_form_header" id="edit_head"></td></tr>
			<tr><td>Type</td><td><select name="type" onchange="type_changed()">
				<option value="cifs">Windows / Samba (CIFS)</option>
				<option value="nfs">NFS</option>
			</select></td></tr>
			<tr><td>Server</td><td><input type="text" name="ip" size="30" title="name or address of the server"/></td></tr>
			<tr><td id="dir_label">Share</td><td><input type="text" name="dir" size="30"/></td></tr>
			<tr id="login1"><td>User</td><td><input type="text" name="username" size="30"/></td></tr>
			<tr id="login2"><td>Password</td><td><input type="password" name="password" size="30" title="empty keeps the saved password"/></td></tr>
			<tr><td>Local directory</td><td><input type="text" name="local_dir" size="30"/></td></tr>
			<tr><td>Mount at start</td><td><input type="checkbox" name="automount"/></td></tr>
			<tr><td>Options</td><td><input type="text" name="options1" size="30"/> <input type="text" name="options2" size="30"/></td></tr>
			<tr><td>MAC to wake the server</td><td><input type="text" name="mac" size="30"/></td></tr>
		</table>
		<input type="button" value="Save and mount" onclick="save(true)"/>
		<input type="button" value="Save" onclick="save(false)"/>
		<input type="button" value="Remove" onclick="clear_entry()"/>
		<input type="button" value="Cancel" onclick="document.getElementById('edit').style.display = 'none'"/>
		</div>
	</form>
	<pre id="result"></pre>
	</div>
</div>
<script type="text/javascript">
//<![CDATA[
	refresh();
//]]>
</script>
</body>
</html>
{=include-block:Y_Blocks.txt;management_check_bottom=}
