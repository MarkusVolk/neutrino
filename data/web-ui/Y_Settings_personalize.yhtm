					<input type="radio" name="p_picviewer" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_picviewer" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_picviewer" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:upnpbrowser.head=}</td>
				<td>
					<input type="radio" name="p_upnp" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_upnp" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_upnp" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:mainmenu.sleeptimer=}</td>
				<td>
					<input type="radio" name="p_sleeptimer" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_sleeptimer" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_sleeptimer" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:mainmenu.reboot=}</td>
				<td>
					<input type="radio" name="p_reboot" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_reboot" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_reboot" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:mainmenu.shutdown=}</td>
				<td>
					<input type="radio" name="p_shutdown" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_shutdown" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_shutdown" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td colspan="2" class="y_form_header">{=L:mainmenu.settings=}</td></tr>
			<tr><td>{=L:set.personalize.settings_pin=}</td>
				<td>
					<input type="radio" name="p_settings" value="1"/>{=L:messagebox.yes=}&nbsp;
					<input type="radio" name="p_settings" value="0"/>{=L:messagebox.no=}
				</td>
			</tr>
			<tr><td>{=L:mainsettings.video=}</td>
				<td>
					<input type="radio" name="p_video" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_video" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_video" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:mainsettings.audio=}</td>
				<td>
					<input type="radio" name="p_audio" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_audio" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_audio" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:parentallock.parentallock=}</td>
				<td>
					<input type="radio" name="p_youth" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_youth" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_youth" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:mainsettings.network=}</td>
				<td>
					<input type="radio" name="p_network" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_network" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_network" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:mainsettings.recording=}</td>
				<td>
					<input type="radio" name="p_recording" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_recording" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_recording" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:mainsettings.language=}</td>
				<td>
					<input type="radio" name="p_language" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_language" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_language" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:mainsettings.osd=}</td>
				<td>
					<input type="radio" name="p_colors" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_colors" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_colors" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:mainsettings.lcd=}</td>
				<td>
					<input type="radio" name="p_lcd" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_lcd" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_lcd" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:mainsettings.keybinding=}</td>
