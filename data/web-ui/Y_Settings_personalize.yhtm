					<input type="radio" name="p_mediaplayer" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_mediaplayer" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_mediaplayer" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:set.personalize.driver=}</td>
				<td>
					<input type="radio" name="p_driver" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_driver" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_driver" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
