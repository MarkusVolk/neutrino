				<td>
					<input type="radio" name="p_misc" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_misc" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_misc" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td colspan="2" class="y_form_header">{=L:servicemenu.head=}</td></tr>
			<tr><td>{=L:set.personalize.service_pin=}</td>
				<td>
					<input type="radio" name="p_service" value="1"/>{=L:messagebox.yes=}&nbsp;
					<input type="radio" name="p_service" value="0"/>{=L:messagebox.no=}
				</td>
			</tr>
			<tr><td>{=L:bouqueteditor.name=}</td>
				<td>
					<input type="radio" name="p_bouqueteditor" value="0"/>{=L:personalize.notvisible=}&nbsp;
					<input type="radio" name="p_bouqueteditor" value="1"/>{=L:personalize.visible=}&nbsp;
					<input type="radio" name="p_bouqueteditor" value="2"/>{=L:personalize.pin=}
				</td>
			</tr>
			<tr><td>{=L:servicemenu.scants=}</td>
				<td>
					<input type="radio" name="p_scants" value="0"/>{=L:personalize.notvisible=}&nbsp;
